# =====================================================================
# Zalo AI Challenge 2026 - DataMate (.gitignore)
# =====================================================================

# 1. Ignore large compressed archives (>100MB GitHub limit)
#    Unzipped data/train/ and data/public_test/ ARE tracked for the team!
*.zip
*.tar.gz
*.7z
data/*.zip

# 2. Outputs & Logs
result/*
!result/.gitkeep

# 3. Model Weights & Checkpoints (Rule 2: declare in README, do not push to git)
models/
Model/
weights/
checkpoints/
lora_adapters/
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.onnx

# 4. Temporary & Log files
tmp/
logs/
*.log

# 5. Python / Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# 6. Jupyter Notebooks & IDE
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 7. Environment secrets
.env
.env.local

# Local datasets/derived labels; already tracked files remain tracked
/data/
/eval_gold/

# Local caches and experiment tracking
.pytest_cache/
.cache/
wandb/
